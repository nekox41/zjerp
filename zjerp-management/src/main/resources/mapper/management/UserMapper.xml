<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.aameow.management.mapper.UserMapper">
    
    <resultMap type="User" id="UserResult">
        <result property="id"    column="id"    />
        <result property="userName"    column="user_name"    />
        <result property="userType"    column="user_type"    />
        <result property="userPhone"    column="user_phone"    />
        <result property="userBrithday"    column="user_brithday"    />
        <result property="userAge"    column="user_age"    />
        <result property="userChinaid"    column="user_chinaid"    />
        <result property="userCert"    column="user_cert"    />
    </resultMap>

    <resultMap id="UserUserFileResult" type="User" extends="UserResult">
        <collection property="userFileList" ofType="UserFile" column="id" select="selectUserFileList" />
    </resultMap>

    <resultMap type="UserFile" id="UserFileResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="tag"    column="tag"    />
        <result property="file"    column="file"    />
    </resultMap>

    <sql id="selectUserVo">
        select id, user_name, user_type, user_phone, user_brithday, user_age, user_chinaid, user_cert from zj_user
    </sql>

    <select id="selectUserList" parameterType="User" resultMap="UserResult">
        <include refid="selectUserVo"/>
        <where>  
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="userType != null  and userType != ''"> and user_type = #{userType}</if>
            <if test="userPhone != null  and userPhone != ''"> and user_phone like concat('%', #{userPhone}, '%')</if>
            <if test="userBrithday != null "> and user_brithday = #{userBrithday}</if>
            <if test="userAge != null "> and user_age = #{userAge}</if>
            <if test="userChinaid != null  and userChinaid != ''"> and user_chinaid like concat('%', #{userChinaid}, '%')</if>
            <if test="userCert != null  and userCert != ''"> and user_cert like concat('%', #{userCert}, '%')</if>
        </where>
    </select>
    
    <select id="selectUserById" parameterType="Long" resultMap="UserUserFileResult">
        select id, user_name, user_type, user_phone, user_brithday, user_age, user_chinaid, user_cert
        from zj_user
        where id = #{id}
    </select>

    <select id="selectUserFileList" resultMap="UserFileResult">
        select id, user_id, tag, file
        from zj_userfile
        where user_id = #{user_id}
    </select>

    <insert id="insertUser" parameterType="User">
        insert into zj_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="userType != null">user_type,</if>
            <if test="userPhone != null">user_phone,</if>
            <if test="userBrithday != null">user_brithday,</if>
            <if test="userAge != null">user_age,</if>
            <if test="userChinaid != null">user_chinaid,</if>
            <if test="userCert != null">user_cert,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="userType != null">#{userType},</if>
            <if test="userPhone != null">#{userPhone},</if>
            <if test="userBrithday != null">#{userBrithday},</if>
            <if test="userAge != null">#{userAge},</if>
            <if test="userChinaid != null">#{userChinaid},</if>
            <if test="userCert != null">#{userCert},</if>
         </trim>
    </insert>

    <update id="updateUser" parameterType="User">
        update zj_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="userPhone != null">user_phone = #{userPhone},</if>
            <if test="userBrithday != null">user_brithday = #{userBrithday},</if>
            <if test="userAge != null">user_age = #{userAge},</if>
            <if test="userChinaid != null">user_chinaid = #{userChinaid},</if>
            <if test="userCert != null">user_cert = #{userCert},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUserById" parameterType="Long">
        delete from zj_user where id = #{id}
    </delete>

    <delete id="deleteUserByIds" parameterType="String">
        delete from zj_user where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteUserFileByUserIds" parameterType="String">
        delete from zj_userfile where user_id in 
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <delete id="deleteUserFileByUserId" parameterType="Long">
        delete from zj_userfile where user_id = #{userId}
    </delete>

    <insert id="batchUserFile">
        insert into zj_userfile( id, user_id, tag, file) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.userId}, #{item.tag}, #{item.file})
        </foreach>
    </insert>
</mapper>