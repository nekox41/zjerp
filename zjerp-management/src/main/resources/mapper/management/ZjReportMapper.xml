<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.aameow.management.mapper.ZjReportMapper">

    <resultMap type="ZjReport" id="ZjReportResult">
        <result property="id"    column="id"    />
        <result property="reportId"    column="report_id"    />
        <result property="reportName"    column="report_name"    />
        <result property="reportFile"    column="report_file"    />
        <result property="reportAttach"    column="report_attach"    />
        <result property="reportType"    column="report_type"    />
        <result property="reportIsfinal"    column="report_isfinal"    />
        <result property="reportManager"    column="report_manager"    />
        <result property="reportArea"    column="report_area"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectZjReportVo">
        select id, report_id, report_name, report_file, report_attach, report_type, report_isfinal, report_manager, report_area, create_by, create_time, update_by, update_time from zj_report
    </sql>

    <select id="selectZjReportList" resultMap="ZjReportResult">
        <include refid="selectZjReportVo"/>
        <where>
            <if test="zjReport.reportId != null  and zjReport.reportId != ''"> and report_id like concat('%', #{zjReport.reportId}, '%')</if>
            <if test="zjReport.reportName != null  and zjReport.reportName != ''"> and report_name like concat('%', #{zjReport.reportName}, '%')</if>
            <if test="zjReport.reportType != null  and zjReport.reportType != ''"> and report_type = #{zjReport.reportType}</if>
            <if test="zjReport.reportIsfinal != null  and zjReport.reportIsfinal != ''"> and report_isfinal = #{zjReport.reportIsfinal}</if>
            <if test="zjReport.reportManager != null  and zjReport.reportManager != ''"> and report_manager = #{zjReport.reportManager}</if>
            <if test="zjReport.reportArea != null  and zjReport.reportArea != ''"> and report_area = #{zjReport.reportArea}</if>
            <if test="zjReport.createBy != null  and zjReport.createBy != ''"> and create_by = #{zjReport.createBy}</if>
            <if test="zjReport.updateBy != null  and zjReport.updateBy != ''"> and update_by = #{zjReport.updateBy}</if>
        </where>
        ORDER BY
        <choose>
            <when test="sortBy == 'updateTime'">
                <choose>
                    <when test="zjReport.updateTime != null">update_time</when>
                    <otherwise>create_time</otherwise>
                </choose>
            </when>
            <otherwise>id</otherwise>
        </choose>
        <choose>
            <when test="orderBy == 'desc'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </select>

    <select id="selectZjReportById" parameterType="Long" resultMap="ZjReportResult">
        <include refid="selectZjReportVo"/>
        where id = #{id}
    </select>

    <insert id="insertZjReport" parameterType="ZjReport" useGeneratedKeys="true" keyProperty="id">
        insert into zj_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reportId != null">report_id,</if>
            <if test="reportName != null and reportName != ''">report_name,</if>
            <if test="reportFile != null and reportFile != ''">report_file,</if>
            <if test="reportAttach != null and reportAttach != ''">report_attach,</if>
            <if test="reportType != null">report_type,</if>
            <if test="reportIsfinal != null">report_isfinal,</if>
            <if test="reportManager != null">report_manager,</if>
            <if test="reportArea != null">report_area,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reportId != null">#{reportId},</if>
            <if test="reportName != null and reportName != ''">#{reportName},</if>
            <if test="reportFile != null and reportFile != ''">#{reportFile},</if>
            <if test="reportAttach != null and reportAttach != ''">#{reportAttach},</if>
            <if test="reportType != null">#{reportType},</if>
            <if test="reportIsfinal != null">#{reportIsfinal},</if>
            <if test="reportManager != null">#{reportManager},</if>
            <if test="reportArea != null">#{reportArea},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateZjReport" parameterType="ZjReport">
        update zj_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="reportId != null">report_id = #{reportId},</if>
            <if test="reportName != null and reportName != ''">report_name = #{reportName},</if>
            <if test="reportFile != null and reportFile != ''">report_file = #{reportFile},</if>
            <if test="reportAttach != null and reportAttach != ''">report_attach = #{reportAttach},</if>
            <if test="reportType != null">report_type = #{reportType},</if>
            <if test="reportIsfinal != null">report_isfinal = #{reportIsfinal},</if>
            <if test="reportManager != null">report_manager = #{reportManager},</if>
            <if test="reportArea != null">report_area = #{reportArea},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteZjReportById" parameterType="Long">
        delete from zj_report where id = #{id}
    </delete>

    <delete id="deleteZjReportByIds" parameterType="String">
        delete from zj_report where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>