<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.aameow.management.mapper.ZjContractMapper">

    <resultMap type="ZjContract" id="ZjContractResult">
        <result property="id"    column="id"    />
        <result property="contractId"    column="contract_id"    />
        <result property="contractType"    column="contract_type"    />
        <result property="contractName"    column="contract_name"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="manager"    column="manager"    />
        <result property="amount"    column="amount"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="contractFile"    column="contract_file"    />
    </resultMap>

    <sql id="selectZjContractVo">
        select id, contract_id, contract_type, contract_name, start_time, end_time, manager, amount, create_by, create_time, update_by, update_time, remark, contract_file from zj_contract
    </sql>

    <select id="selectZjContractList" resultMap="ZjContractResult">
        <include refid="selectZjContractVo"/>
        <where>
            <if test="zjContract.contractId != null  and zjContract.contractId != ''"> and contract_id = #{zjContract.contractId}</if>
            <if test="zjContract.contractType != null "> and contract_type = #{zjContract.contractType}</if>
            <if test="zjContract.contractName != null  and zjContract.contractName != ''"> and contract_name like concat('%', #{zjContract.contractName}, '%')</if>
            <if test="zjContract.manager != null  and zjContract.manager != ''"> and manager = #{zjContract.manager}</if>
        </where>
        ORDER BY
        <choose>
            <when test="sortBy == 'updateTime'">
                <choose>
                    <when test="zjContract.updateTime != null">update_time</when>
                    <otherwise>create_time</otherwise>
                </choose>
            </when>
            <otherwise>id</otherwise>
        </choose>
        <choose>
            <when test="orderBy == 'DESC'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </select>

    <select id="selectZjContractById" parameterType="Long" resultMap="ZjContractResult">
        <include refid="selectZjContractVo"/>
        where id = #{id}
    </select>

    <insert id="insertZjContract" parameterType="ZjContract" useGeneratedKeys="true" keyProperty="id">
        insert into zj_contract
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="contractId != null and contractId != ''">contract_id,</if>
            <if test="contractType != null">contract_type,</if>
            <if test="contractName != null and contractName != ''">contract_name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="manager != null and manager != ''">manager,</if>
            <if test="amount != null">amount,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="contractFile != null">contract_file,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="contractId != null and contractId != ''">#{contractId},</if>
            <if test="contractType != null">#{contractType},</if>
            <if test="contractName != null and contractName != ''">#{contractName},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="manager != null and manager != ''">#{manager},</if>
            <if test="amount != null">#{amount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="contractFile != null">#{contractFile},</if>
        </trim>
    </insert>

    <update id="updateZjContract" parameterType="ZjContract">
        update zj_contract
        <trim prefix="SET" suffixOverrides=",">
            <if test="contractId != null and contractId != ''">contract_id = #{contractId},</if>
            <if test="contractType != null">contract_type = #{contractType},</if>
            <if test="contractName != null and contractName != ''">contract_name = #{contractName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="manager != null and manager != ''">manager = #{manager},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="contractFile != null">contract_file = #{contractFile},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteZjContractById" parameterType="Long">
        delete from zj_contract where id = #{id}
    </delete>

    <delete id="deleteZjContractByIds" parameterType="String">
        delete from zj_contract where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countByContractType" resultType="int">
        SELECT COUNT(*) FROM zj_contract WHERE contract_type = #{contractType}
    </select>
</mapper>