# 可以直接运行 python3 scripts/init-compose-env.py 生成随机密钥的 .env。
HTTP_PORT=8088
MYSQL_DATABASE=server
MYSQL_USER=zjerp
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
# JJWT 使用 Base64 密钥，建议 openssl rand -base64 64 | tr -d '\n'。
TOKEN_SECRET=
PUBLIC_API_URL=http://localhost:8088/prod-api
FRONTEND_CONTEXT=../zjerp_frontend
# 新安装 true；导入旧数据库时第一次启动前设为 false。
BOOTSTRAP_DATABASE=true
