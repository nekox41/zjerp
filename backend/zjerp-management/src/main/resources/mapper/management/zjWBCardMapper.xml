<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.aameow.management.mapper.zjWBCardMapper">
    
    <resultMap type="zjWBCard" id="zjWBCardResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="title"    column="title"    />
        <result property="file"    column="file"    />
        <result property="printCheck"    column="print_check"    />
        <result property="sendCheck"    column="send_check"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="WBCardPhoneResult" type="WBCardPhone">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="phone" column="phone" />
    </resultMap>

    <sql id="selectzjWBCardVo">
        select id, code, title, file, print_check, send_check, create_by, create_time, update_by, update_time, remark from zj_wbcard
    </sql>

    <sql id="selectWBCardPhoneVo">
        select id, name, phone from zjerp_wbcard_phone
    </sql>

    <select id="selectzjWBCardList" parameterType="zjWBCard" resultMap="zjWBCardResult">
        <include refid="selectzjWBCardVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="printCheck != null  and printCheck != ''"> and print_check = #{printCheck}</if>
            <if test="sendCheck != null  and sendCheck != ''"> and send_check = #{sendCheck}</if>
        </where>
        <choose><when test="params.cardSort == 'code'">ORDER BY CASE WHEN code REGEXP '^[0-9]+$' THEN CAST(code AS DECIMAL(30,0)) END DESC,code DESC,id DESC</when><otherwise>ORDER BY create_time DESC,id DESC</otherwise></choose>
    </select>

    <select id="getPhoneList" resultMap="WBCardPhoneResult" parameterType="WBCardPhone">
        <include refid="selectWBCardPhoneVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectzjWBCardById" parameterType="Long" resultMap="zjWBCardResult">
        <include refid="selectzjWBCardVo"/>
        where id = #{id}
    </select>

    <insert id="insertzjWBCard" parameterType="zjWBCard" useGeneratedKeys="true" keyProperty="id">
        insert into zj_wbcard
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null">code,</if>
            <if test="title != null">title,</if>
            <if test="printCheck != null">print_check,</if>
            <if test="sendCheck != null">send_check,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null">#{code},</if>
            <if test="title != null">#{title},</if>
            <if test="printCheck != null">#{printCheck},</if>
            <if test="sendCheck != null">#{sendCheck},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <insert id="insertWBCardPhone" parameterType="WBCardPhone" useGeneratedKeys="true" keyProperty="id">
        insert into zjerp_wbcard_phone (name, phone) values(#{name}, #{phone})
    </insert>

    <update id="updatezjWBCard" parameterType="zjWBCard">
        update zj_wbcard
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null">code = #{code},</if>
            <if test="title != null">title = #{title},</if>
            <if test="file != null">file = null,</if>
            <if test="printCheck != null">print_check = #{printCheck},</if>
            <if test="sendCheck != null">send_check = #{sendCheck},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletezjWBCardById" parameterType="Long">
        delete from zj_wbcard where id = #{id}
    </delete>

    <delete id="deletezjWBCardByIds" parameterType="String">
        delete from zj_wbcard where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteWBCardPhoneById" parameterType="Long">
        delete from zjerp_wbcard_phone where id = #{id}
    </delete>
</mapper>