ARG ERP_IMAGE_PREFIX=
FROM ${ERP_IMAGE_PREFIX}eclipse-temurin:17-jre
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 app \
    && mkdir -p /var/lib/erp-next/files \
    && chown -R app:app /var/lib/erp-next
COPY --chmod=0644 target/erp-next-api-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8090/actuator/health || exit 1
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75.0","-jar","/app/app.jar"]
