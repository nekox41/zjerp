# Copy to .env.local and pass with --env-file. Use unique secrets; never commit real credentials.
ERP_NEXT_DB_ROOT_PASSWORD=replace-with-a-unique-root-secret
ERP_NEXT_DB_PASSWORD=replace-with-a-unique-app-secret
ERP_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-setup-secret
ERP_NEXT_API_PORT=8090
ERP_NEXT_WEB_PORT=8089

# Legacy production migration is deferred until ERP V1 is complete.
ERP_LEGACY_SCAN_ENABLED=false
