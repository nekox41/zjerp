# Copy to .env.local and pass with --env-file. Use unique secrets; never commit real credentials.
ERP_NEXT_DB_ROOT_PASSWORD=replace-with-a-unique-root-secret
ERP_NEXT_DB_PASSWORD=replace-with-a-unique-app-secret
ERP_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-setup-secret
ERP_NEXT_API_PORT=8090
ERP_NEXT_WEB_PORT=8089

# Optional offline legacy copy scanner (disabled by default). Do not use the live server DB.
ERP_LEGACY_SCAN_ENABLED=false
ERP_LEGACY_DB_URL=
ERP_LEGACY_DB_USER=
ERP_LEGACY_DB_PASSWORD=
ERP_LEGACY_DB_SCHEMA=server_migration

# Optional administrator-only read-only detection of an existing server catalog:
# ERP_LEGACY_SCAN_ENABLED=true
# ERP_LEGACY_DB_SCHEMA=server
# ERP_LEGACY_DB_URL=jdbc:mysql://your-authorized-host:3306/server
# ERP_LEGACY_DB_USER=readonly_user
# ERP_LEGACY_DB_PASSWORD=your_readonly_password
# Actual business migration still requires an offline server_* copy.
