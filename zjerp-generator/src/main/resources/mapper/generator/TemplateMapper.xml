<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.aameow.generator.mapper.TemplateMapper">
    
    <resultMap id="TemplateResult" type="top.aameow.generator.domain.Template">
        <id property="name" column="name" />
        <result property="file" column="file" />
    </resultMap>

    <select id="getTemplateByName" resultType="top.aameow.generator.domain.Template">
        SELECT name, file FROM templates WHERE name = #{name}
    </select>
</mapper>